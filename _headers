# Cloudflare Pages response headers.
#
# Order matters: Pages applies every matching rule and the LAST one wins for a
# given header. The general /assets/* rule therefore has to come BEFORE the
# font rule, or it overrides it -- which is what pinned the fonts to 7 days.

/assets/*
  Cache-Control: public, max-age=604800

# Font filenames never change content, so they can be cached indefinitely.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
